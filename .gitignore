# ==============================================
# 环境变量与密钥（绝对不能提交）
# ==============================================
.env
.env.*
!.env.example

# ==============================================
# Python 运行产物
# ==============================================
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
env/
build/
dist/

# ==============================================
# 运行期生成的数据（可按文档重新构建，不入库）
# ==============================================
# 本地嵌入模型 bge-m3（约 2.1GB，远超 GitHub 单文件 100MB 限制）
data/models/
# HuggingFace 缓存
data/hf_cache/
# 向量库（Chroma 集合 + 稀疏索引 + 集合映射表）
data/chroma_db/
# 知识图谱（按文档重建，抽取会产生费用）
data/kg/
# 运行时合成的音频
data/audio/
# 用户偏好槽位（个人使用数据）
data/user_prefs.json

# ==============================================
# 个人信息 / 私有材料（不公开）
# ==============================================
.workbuddy/
# 根目录下的简历、课设报告等个人文档（data/docs 下的示例文档不受影响）
/*.docx
/*.pdf
面试指南-多Agent语音知识库问答系统.md
面试与简历准备.md
# 含他人联系方式，不公开
data/docs/课程作业评分标准.txt

# ==============================================
# 评测输出（结果文件，重新跑即生成）
# ==============================================
tests/results/*.csv
*.part

# ==============================================
# 编辑器 / 系统
# ==============================================
.idea/
.DS_Store
Thumbs.db
*.log
